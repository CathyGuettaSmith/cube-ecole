# Exemple de variables. Ne jamais mettre de vraies valeurs dans ce fichier :
# elles se renseignent dans l'onglet « Variables » de Railway.

# Cube·École est une app publique : c'est la seule variable à renseigner.
ACCESS_MODE=public

# Seulement si l'app devenait privée un jour (voir ../GUIDE.md, étape 7) :
# ACCESS_MODE=private
# CF_ACCESS_TEAM_DOMAIN=monequipe.cloudflareaccess.com
# CF_ACCESS_AUD=coller-ici-l-AUD-tag-de-l-application-Access
